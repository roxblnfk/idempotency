# Line-ending normalization for text files.
* text=auto

# PHP-aware hunk headers in `git diff`.
*.php diff=php

# Default: nothing is included in the `composer archive` of spiral/idempotency.
# Re-include only the files that actually belong to the package.
* export-ignore

# Top-level documentation and the manifest itself.
/composer.json   -export-ignore
/LICENSE.md      -export-ignore
/README.md       -export-ignore
/CHANGELOG.md    -export-ignore

# Package source code (`Spiral\Idempotency\` namespace).
/src             -export-ignore
/src/**          -export-ignore

# AI skill
/skills          -export-ignore
/skills/**       -export-ignore
