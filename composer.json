{
    "name": "spiral/idempotency",
    "description": "Idempotency guarantees (AtLeastOnce lease / ExactlyOnce inbox) for Spiral Framework operations.",
    "type": "library",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Aleksei Gagarin",
            "homepage": "https://github.com/roxblnfk"
        }
    ],
    "require": {
        "php": ">=8.4",
        "cycle/transaction": "^1.1",
        "psr/clock": "^1.0",
        "spiral/boot": "^3.15",
        "spiral/serializer": "^3.15"
    },
    "require-dev": {
        "testo/testo": "^0.10.20",
        "infection/infection": "^0.33.2",
        "vimeo/psalm": "^7",
        "llm/skills": "dev-master",
        "cycle/skills": "1.x-dev",
        "cycle/database": "^2.21",
        "cycle/schema-builder": "^2.12",
        "spiral/cycle-bridge": "^2.13",
        "spiral/interceptors": "^3.15",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/http-factory": "^1.0",
        "nyholm/psr7": "^1.8",
        "spiral/dumper": "^3.3"
    },
    "suggest": {
        "cycle/database": "Use the bundled Cycle driver (lease/inbox storage over a Cycle DBAL connection) — required by everything under Spiral\\Idempotency\\Driver\\Cycle.",
        "spiral/cycle-bridge": "Integrate the idempotency tables into the Cycle ORM schema (cycle:migrate / cycle:sync) via CycleSchemaBootloader — also pulls cycle/schema-builder.",
        "spiral/interceptors": "Make HTTP controller actions idempotent declaratively with the #[Idempotent] attribute via IdempotencyInterceptor (also needs a PSR-17 factory)."
    },
    "autoload": {
        "psr-4": {
            "Spiral\\Idempotency\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Spiral\\Idempotency\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "testo",
        "test:unit": "testo --suite=Unit",
        "test:acceptance": "testo --suite=Acceptance",
        "test:no-driver": "testo --group=!driver",
        "test:sqlite": "testo --suite=Acceptance --group=driver-sqlite",
        "test:pgsql": "testo --suite=Acceptance --group=driver-pgsql",
        "test:mysql": "testo --suite=Acceptance --group=driver-mysql",
        "psalm": "psalm",
        "infection": "infection"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true,
            "llm/skills": true
        }
    }
}
